# Copy to .env and fill in what you need. Never commit .env.

# Require this bearer token on every API call (recommended if anything other than you can reach the port).
# Enter the same value in Settings → API access token in the UI.
TIMEOS_API_TOKEN=

# Timezone for first-run settings (change it later in Settings).
TIMEOS_DEFAULT_TIMEZONE=Europe/London

# Host port for the web UI (bound to 127.0.0.1).
TIMEOS_PORT=8080

# Only for docker-compose.postgres.yml.
POSTGRES_PASSWORD=

# Phase 3 (Google Calendar) and Phase 5 (Claude) — not used yet.
# TIMEOS_SECRET_KEY=          # encrypts stored OAuth tokens
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=          # server-side only; never exposed to the browser
