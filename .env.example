# Copy to .env and fill in what you need. Never commit .env.

# Require this bearer token on every API call (recommended if anything other than you can reach the port).
# The UI asks for it once per browser (it can be changed later in Settings).
TIMEOS_API_TOKEN=

# Timezone for first-run settings (change it later in Settings).
TIMEOS_DEFAULT_TIMEZONE=Europe/London

# Host port for the web UI (bound to 127.0.0.1).
TIMEOS_PORT=8080

# Only for docker-compose.postgres.yml.
POSTGRES_PASSWORD=

# Encrypts stored secrets such as calendar links. Leave empty locally and a random key is created in
# data/secret.key on first use (back it up with the database). Set it on hosts without a persistent disk.
TIMEOS_SECRET_KEY=

# Later phases (Google OAuth, Claude) — not used yet.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=          # server-side only; never exposed to the browser
